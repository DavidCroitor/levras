<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="levras.Presentation.App"
             xmlns:views="using:levras.Presentation.Views"
             xmlns:vm="using:levras.Presentation.ViewModels"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://levras.Presentation/Theme/Palette.axaml"/>
                <ResourceInclude Source="avares://levras.Presentation/Theme/Tokens.axaml"/>
                <ResourceInclude Source="avares://levras.Presentation/Theme/ControlThemes.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:TextEditorTabViewModel}">
            <views:TextEditorTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImageViewerTabViewModel}">
            <views:ImageViewerTabView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://levras.Presentation/Theme/Styles.axaml"/>
    </Application.Styles>
</Application>