<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:levras.Presentation.ViewModels"
             x:Class="levras.Presentation.Views.WorkspaceExplorerView"
             x:DataType="vm:WorkspaceExplorerViewModel"> 

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4">
            <Button Content="New File" 
                    Command="{Binding BeginCreateFileCommand}" 
                    CommandParameter="{Binding SelectedItem}"
                    IsEnabled="{Binding IsWorkspaceOpen}"
                    IsVisible="{Binding IsWorkspaceOpen}"/>
            <Button Content="New Folder" 
                    Command="{Binding BeginCreateFolderCommand}" 
                    CommandParameter="{Binding SelectedItem}"
                    IsEnabled="{Binding IsWorkspaceOpen}"
                    IsVisible="{Binding IsWorkspaceOpen}"/>
        </StackPanel>

        <TreeView ItemsSource="{Binding RootItems}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  MinWidth="200">
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:WorkspaceItemViewModel">
                    <Setter Property="Classes.activeFile" Value="{Binding ShowActiveIndicator}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="ToolTip.Tip" Value="{Binding Name}"/>
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Rename"
                                          Command="{Binding $parent[TreeView].((vm:WorkspaceExplorerViewModel)DataContext).BeginRenameCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Delete"
                                          Command="{Binding $parent[TreeView].((vm:WorkspaceExplorerViewModel)DataContext).DeleteNodeCommand}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                    <Border Classes="treeRow" 
                            HorizontalAlignment="Stretch"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <Grid VerticalAlignment="Stretch" ColumnDefinitions="Auto,14,*">
                                <ItemsControl Grid.Column="0"
                                        ItemsSource="{Binding IndentGuides}"
                                        VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="18" VerticalAlignment="Stretch">
                                            <Border Width="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Stretch"
                                                    Background="{StaticResource BorderBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <ToggleButton Grid.Column="1"
                                        Classes="treeToggle"
                                        Margin="3,0,5,0"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                        Opacity="{Binding IsDirectory}"
                                        IsHitTestVisible="{Binding IsDirectory}">
                                <TextBlock Classes="chevronGlyph" Text="&#8250;" />
                            </ToggleButton>

                            <Border Grid.Column="2"
                                    HorizontalAlignment="Stretch" 
                                    Padding="0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="2">
                                    <Grid Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                Margin="5,0"
                                                Padding="0,5"
                                                IsVisible="{Binding !IsEditing}"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                VerticalAlignment="Center" 
                                                DoubleTapped="OnNodeDoubleTapped"/>
                                        <TextBox Text="{Binding EditingName}" IsVisible="{Binding IsEditing}"
                                                KeyDown="OnRenameTextBoxKeyDown" LostFocus="OnRenameTextBoxLostFocus" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>