<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:levras.Presentation.ViewModels"
             x:Class="levras.Presentation.Views.WorkspaceExplorerView"
             x:DataType="vm:WorkspaceExplorerViewModel">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4">
            <Button Content="New File" 
                    Command="{Binding BeginCreateFileCommand}" 
                    CommandParameter="{Binding SelectedItem}"
                    IsEnabled="{Binding IsWorkspaceOpen}"
                    IsVisible="{Binding IsWorkspaceOpen}"/>
            <Button Content="New Folder" 
                    Command="{Binding BeginCreateFolderCommand}" 
                    CommandParameter="{Binding SelectedItem}"
                    IsEnabled="{Binding IsWorkspaceOpen}"
                    IsVisible="{Binding IsWorkspaceOpen}"/>
        </StackPanel>

        <TreeView ItemsSource="{Binding RootItems}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"  >
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:WorkspaceItemViewModel">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Classes.activeFile" Value="{Binding ShowActiveIndicator}" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Header="Rename"
                                          Command="{Binding $parent[TreeView].((vm:WorkspaceExplorerViewModel)DataContext).BeginRenameCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Delete"
                                          Command="{Binding $parent[TreeView].((vm:WorkspaceExplorerViewModel)DataContext).DeleteNodeCommand}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                    <Grid VerticalAlignment="Stretch" ColumnDefinitions="10,*">

                        <Border Grid.Column="0" Width="1"
                                VerticalAlignment="Stretch"
                                Background="{StaticResource BorderBrush}"
                                IsVisible="{Binding ShowGuideline}"/>

                        <Border Grid.Column="1"
                                HorizontalAlignment="Stretch" 
                                Padding="0">
                            <Grid ColumnDefinitions="14,*" 
                                    ColumnSpacing="2">
                                <TextBlock Grid.Column="0" 
                                        Text="{Binding Icon}"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        VerticalAlignment="Center" 
                                        TextAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" 
                                            IsVisible="{Binding !IsEditing}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            VerticalAlignment="Center"
                                            DoubleTapped="OnNodeDoubleTapped" />
                                    <TextBox Text="{Binding EditingName}" IsVisible="{Binding IsEditing}"
                                            KeyDown="OnRenameTextBoxKeyDown" LostFocus="OnRenameTextBoxLostFocus" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>