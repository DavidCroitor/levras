<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="levras.Presentation.Views.NameDialog"
        Width="380" Height="150"
        Background="{StaticResource EditorBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Height">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBox x:Name="NameTextBox"
                PlaceholderText="Workspace name"
                MinWidth="340" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Done" Classes="dialogPrimary" Click="OnDoneClick" />
            <Button Content="Cancel" Classes="dialogPrimary" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>