<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="levras.Presentation.Views.ConfirmDialog"
        Width="380" Height="150"
        Background="{StaticResource EditorBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True">
    <Grid RowDefinitions="16,*">
        <Border Grid.Row="0"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar" />
    <StackPanel Grid.Row="1" Margin="20" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Yes" Classes="dialogPrimary" Click="OnYesClick" />
            <Button x:Name="NoButton" Content="No" Classes="dialogDanger" Click="OnNoClick" />
        </StackPanel>
    </StackPanel>
    </Grid>
</Window>