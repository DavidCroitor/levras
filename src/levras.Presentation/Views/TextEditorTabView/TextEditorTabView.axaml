<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:levras.Presentation.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:md="using:Markdown.Avalonia"
             x:Class="levras.Presentation.Views.TextEditorTabView"
             x:DataType="vm:TextEditorTabViewModel">

    <Grid ColumnDefinitions="*,4,*">

        <Border Grid.Column="0" Background="{StaticResource EditorBackgroundBrush}">
            <ae:TextEditor Document="{Binding Document}"
                            FontFamily="{StaticResource FontFamilyMono}"
                            FontSize="{StaticResource EditorFontSize}"
                            Foreground="{StaticResource EditorForegroundBrush}"
                            Background="Transparent"
                            ShowLineNumbers="False"
                            WordWrap="True"/>
        </Border>

        <GridSplitter Grid.Column="1"
                      Background="{StaticResource BorderBrush}"
                      ResizeDirection="Columns" />

        <Border Grid.Column="2" Background="{StaticResource PreviewBackgroundBrush}">
            <md:MarkdownScrollViewer Markdown="{Binding MarkdownText}"
                                      Margin="{StaticResource SpacingMedium}" />
        </Border>

    </Grid>
</UserControl>