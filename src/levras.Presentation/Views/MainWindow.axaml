<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:levras.Presentation.Views"
        xmlns:vm="using:levras.Presentation.ViewModels"
        x:Class="levras.Presentation.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="levras"
        Width="1920" Height="1080"
        Background="{StaticResource Slate800}"
        FontFamily="{StaticResource FontFamilyUI}"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp">
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveTabCommand}" />
    </Window.KeyBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Menu Grid.Column="0" 
                        HorizontalAlignment="Left"
                        WindowDecorationProperties.ElementRole="DecorationsElement" >
                    <MenuItem Header="_Workspace">
                        <MenuItem Header="_Open Workspace..."
                                Command="{Binding OpenWorkspaceCommand}"/>
                        <MenuItem Header="_Close Workspace"
                                Command="{Binding CloseWorkspaceCommand}"
                                IsVisible="{Binding Explorer.IsWorkspaceOpen}" />
                        <Separator />
                        <MenuItem Header="_Save File"
                                Command="{Binding SaveActiveTabCommand}"
                                IsVisible="{Binding OpenTabs.Count}"
                                IsEnabled="{Binding OpenTabs.Count}"/>
                        <MenuItem Header="_Close File"
                                Command="{Binding CloseTabCommand}"
                                CommandParameter="{Binding SelectedTab}"
                                IsVisible="{Binding OpenTabs.Count}"
                                IsEnabled="{Binding OpenTabs.Count}"/>

                    </MenuItem>
                </Menu>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="0">
                    <Button Content="—"
                            Classes="captionButton"
                            WindowDecorationProperties.ElementRole="MinimizeButton"
                            Click="OnMinimizeClick" />
                    <Button Content="☐"
                            Classes="captionButton"
                            WindowDecorationProperties.ElementRole="MaximizeButton" 
                            Click="OnMaximizeRestoreClick"/>
                    <Button Content="✕"
                            Classes="captionButton captionButtonClose"
                            WindowDecorationProperties.ElementRole="CloseButton"
                            Click="OnCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid IsVisible="{Binding Explorer.IsWorkspaceOpen}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition   Width="{Binding Explorer.Width, Mode=TwoWay }" 
                                        MinWidth="{Binding Explorer.MinWidth}"
                                        MaxWidth="{Binding Explorer.MaxWidth}"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" 
                        Background="{StaticResource SurfaceBrush}" 
                        CornerRadius="5"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        Margin="2,2,1,2">
                    <views:WorkspaceExplorerView DataContext="{Binding Explorer}" />
                </Border>

                <GridSplitter Grid.Column="1"
                    Background="Transparent"
                    ResizeDirection="Columns"/>
                
                <Border Grid.Column="2" 
                        BorderThickness="1"
                        CornerRadius="5"
                        Margin="1,2,2,2"
                        Padding="2"
                        Background="{StaticResource EditorBackgroundBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}">
                    <Grid
                        Margin="2"
                        Background="{StaticResource EditorBackgroundBrush}" >
                        <TextBlock Text="Open a file to get started"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                IsVisible="{Binding !OpenTabs.Count}" />
                        
                        <TabControl ItemsSource="{Binding OpenTabs}"
                                    SelectedItem="{Binding SelectedTab}"
                                    IsVisible="{Binding OpenTabs.Count}"
                                    Background="Transparent">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" >
                                        <Border Grid.Column="0"
                                                Width="6" Height="6" CornerRadius="3"
                                                Background="{StaticResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsDirty}"/>

                                        <TextBlock Grid.Column="1"
                                                Text="{Binding Title}"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding Title}"/>

                                        <Button Grid.Column="2"
                                                Classes="tabClose"
                                                Content="✕"
                                                Command="{Binding $parent[TabControl].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </TabControl.ItemTemplate>

                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" />
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    
                    </Grid>
                
                </Border>
            </Grid>
        
            <views:WelcomeView IsVisible="{Binding !Explorer.IsWorkspaceOpen}"/>
        </Grid>
    </DockPanel>
</Window>