<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:levras.Presentation.Views"
        xmlns:vm="using:levras.Presentation.ViewModels"
        x:Class="levras.Presentation.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="levras"
        Width="1100" Height="700">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Workspace..."
                          Command="{Binding OpenWorkspaceCommand}" />
                <Separator />
                <MenuItem Header="_Save"
                          Command="{Binding SaveActiveTabCommand}" />
            </MenuItem>
        </Menu>
        <Grid ColumnDefinitions="260,4,*">
            
            <views:WorkspaceExplorerView Grid.Column="0" DataContext="{Binding Explorer}" />
            
            <GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <TextBlock Text="Open a file to get started"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.5"
                           IsVisible="{Binding !OpenTabs.Count}" />

                <TabControl ItemsSource="{Binding OpenTabs}"
                            SelectedItem="{Binding SelectedTab}"
                            IsVisible="{Binding OpenTabs.Count}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button Content="✕"
                                        Command="{Binding $parent[TabControl].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="4,0"
                                        Background="Transparent"
                                        BorderThickness="0" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>