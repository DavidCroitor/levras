<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces: depth hierarchy from deepest to shallowest[cite: 2] -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ThemeDark}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Slate900}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource Slate800}"/>

    <!-- Borders[cite: 2] -->
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ThemeMuted}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Slate700}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource Slate800}"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource Accent600}"/>

    <!-- Text[cite: 2] -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ThemeSand}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ThemeMuted}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource Slate500}"/>

    <!-- Accent[cite: 2] -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent600}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Accent500}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource Accent700}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource Slate50}"/>

    <!-- Editor / Preview panes[cite: 2] -->
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource ThemeDark}"/>
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="{StaticResource ThemeSand}"/>
    <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="{StaticResource Slate800}"/>

    <!-- Selected-text highlight[cite: 2] -->
    <SolidColorBrush x:Key="EditorSelectionBrush" Color="{StaticResource Accent600}" Opacity="0.35"/>

    <!-- Status[cite: 2] -->
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger500}"/>

    <!-- Spacing scale[cite: 2] -->
    <Thickness x:Key="SpacingXSmall">4</Thickness>
    <Thickness x:Key="SpacingSmall">8</Thickness>
    <Thickness x:Key="SpacingMedium">16</Thickness>
    <Thickness x:Key="SpacingLarge">24</Thickness>

    <!-- Corner radius[cite: 2] -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>

    <!-- Typography[cite: 2] -->
    <FontFamily x:Key="FontFamilyUI">avares://levras.Presentation/Assets/Fonts#Inter</FontFamily>
    <FontFamily x:Key="FontFamilyMono">avares://levras.Presentation/Assets/Fonts#JetBrains Mono</FontFamily>
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeDefault">14</x:Double>
    <x:Double x:Key="FontSizeLarge">16</x:Double>
    <x:Double x:Key="EditorFontSize">14</x:Double>

</ResourceDictionary>