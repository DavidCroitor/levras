<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- True Neutral scale[cite: 1] -->
    <Color x:Key="Slate950">#0A0A0A</Color>
    <Color x:Key="Slate900">#171717</Color>
    <Color x:Key="Slate800">#262626</Color>
    <Color x:Key="Slate700">#404040</Color>
    <Color x:Key="Slate600">#525252</Color>
    <Color x:Key="Slate500">#737373</Color>
    <Color x:Key="Slate400">#A3A3A3</Color>
    <Color x:Key="Slate300">#D4D4D4</Color>
    <Color x:Key="Slate200">#E5E5E5</Color>
    <Color x:Key="Slate100">#F5F5F5</Color>
    <Color x:Key="Slate50">#FAFAFA</Color>

    <!-- Custom 60-30 Palette -->
    <Color x:Key="ThemeDark">#001427</Color>
    <Color x:Key="ThemeMuted">#708D81</Color>
    <Color x:Key="ThemeSand">#F4D58D</Color>

    <!-- Red accent: hover / base / pressed[cite: 1] -->
    <Color x:Key="Accent500">#D91919</Color>
    <Color x:Key="Accent600">#BF0603</Color>
    <Color x:Key="Accent700">#8D0801</Color>

    <!-- Reserved for states[cite: 1] -->
    <Color x:Key="Danger500">#E5484D</Color>

</ResourceDictionary>