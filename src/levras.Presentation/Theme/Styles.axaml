<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Tab header container (generated by TabControl per item) -->
    <Style Selector="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeDefault}"/>
    </Style>

    <Style Selector="TabItem:pointerover">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- The ✕ close button inside each tab header -->
    <Style Selector="Button.tabClose">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="Button.tabClose:pointerover">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Application menu bar -->
    <Style Selector="Menu">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <!-- Dropdown items shared by the menu bar's submenus and the explorer's context menu -->
    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
    </Style>

    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
    </Style>

    <Style Selector="MenuItem:selected">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
    </Style>

    <Style Selector="MenuItem:disabled">
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
    </Style>

    <Style Selector="MenuItem Separator">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="6,4"/>
    </Style>

    <!-- Top-level items sit directly on the menu bar, so they get quieter, pill-shaped treatment -->
    <Style Selector="Menu > MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
    </Style>

    <Style Selector="Menu > MenuItem:pointerover">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Menu > MenuItem:selected">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Popup surface for both the menu bar's submenus and any ContextMenu -->
    <Style Selector="MenuFlyoutPresenter, ContextMenu">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}"/>
        <Setter Property="Padding" Value="2,0"/>
    </Style>

    <!-- Workspace Explorer toolbar -->
    <Style Selector="Border.explorerToolbar">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

    <Style Selector="TextBlock.explorerToolbarTitle">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,0,8,0"/>
    </Style>

    <Style Selector="Button.explorerAction">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style Selector="Button.explorerAction:pointerover">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.explorerAction:pressed">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
    </Style>

    <Style Selector="Button.explorerAction:disabled">
        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <!-- Workspace Explorer -->
    <Style Selector="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4,4,4"/>
        <Setter Property="MinWidth" Value="200"/>
    </Style>

    <Style Selector="TreeViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeDefault}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TreeViewItem:pointerover">
    </Style>

    <Style Selector="TreeViewItem Border">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Cancel Fluent's built-in selection fill entirely, in both focus states -->
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TreeViewItem:selected:focus-within /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    
    <Style Selector="TreeViewItem /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="TreeView /template/ ScrollViewer /template/ ScrollContentPresenter#PART_ContentPresenter">
        <Setter Property="CanHorizontallyScroll" Value="False"/>
    </Style>

    <Style Selector="TreeViewItem Border.treeRow:pointerover">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
    </Style>

    <Style Selector="TreeViewItem.activeFile /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    
    <Style Selector="TreeViewItem TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUI}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeDefault}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{StaticResource AccentForegroundBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="TreeViewItem TextBox:focus-visible /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
    </Style>

    <Style Selector="TreeViewItem TextBox:focus">
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="ToggleButton.treeToggle">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleButton.treeToggle TextBlock.chevronGlyph">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="ToggleButton.treeToggle:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ToggleButton.treeToggle:checked TextBlock.chevronGlyph">
        <Setter Property="RenderTransform" Value="rotate(90deg)"/>
    </Style>
</Styles>